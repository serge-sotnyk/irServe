{
  "id": "cache-control-default",
  "description": "Document the Cache-Control header behavior across response types under default config: (a) plain file response, (b) file response with a custom headers rule, (c) HTML directory listing (no index.html in fixture root), (d) 404 missing path. Backs SRV-CACHE-005.",
  "fixture": {
    "files": {
      "asset.css": "body{}\n",
      "tagged.css": "h1{}\n"
    },
    "serveJson": {
      "headers": [
        {
          "source": "**/tagged.css",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=600" }
          ]
        }
      ]
    }
  },
  "snapshot": {
    "volatileBodies": ["default_listing_html", "default_listing_json"]
  },
  "requests": [
    { "name": "default_file_no_rule", "path": "/asset.css" },
    { "name": "default_listing_html", "path": "/" },
    { "name": "default_listing_json", "path": "/", "headers": { "Accept": "application/json" } },
    { "name": "default_404_html", "path": "/missing" },
    { "name": "default_404_json", "path": "/missing", "headers": { "Accept": "application/json" } },
    { "name": "rule_applies_cache_control", "path": "/tagged.css" }
  ]
}
