{
  "id": "cleanurls-array",
  "description": "`cleanUrls` array form: when configured as a list of glob patterns, only matching paths are subject to extension stripping / 301. Closes Q-005 by recording behavior for (a) a path inside the list — 301 to extensionless, (b) a path outside the list — direct 200 from the .html file with no rewrite. Backs SRV-ROUT-001 (array-form scope).",
  "fixture": {
    "files": {
      "docs/guide.html": "<p>guide</p>\n",
      "blog/post.html": "<p>post</p>\n"
    },
    "serveJson": {
      "cleanUrls": [
        "/docs/**"
      ]
    }
  },
  "runner": {
    "l0": {
      "clean": [
        "in_scope_redirect",
        "in_scope_extensionless",
        "out_of_scope_html_direct",
        "out_of_scope_extensionless_miss"
      ],
      "divergent": [],
      "bodyMayDiffer": [
        "out_of_scope_extensionless_miss"
      ],
      "contentLengthMayDiffer": [
        "in_scope_redirect"
      ],
      "contentEncodingMayDiffer": [
        "out_of_scope_extensionless_miss"
      ]
    }
  },
  "requests": [
    {
      "name": "in_scope_redirect",
      "method": "GET",
      "path": "/docs/guide.html"
    },
    {
      "name": "in_scope_extensionless",
      "method": "GET",
      "path": "/docs/guide"
    },
    {
      "name": "out_of_scope_html_direct",
      "method": "GET",
      "path": "/blog/post.html"
    },
    {
      "name": "out_of_scope_extensionless_miss",
      "method": "GET",
      "path": "/blog/post"
    }
  ]
}
