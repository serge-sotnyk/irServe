{
  "id": "rewrites-segment",
  "description": "Rewrite with path-to-regexp segment and SPA-style wildcard. Confirms 200 status (rewrites are silent unlike redirects) and that body is from destination file.",
  "fixture": {
    "files": {
      "edit-project-123.html": "<p>edit-123</p>\n",
      "index.html": "<p>spa-root</p>\n"
    },
    "serveJson": {
      "rewrites": [
        { "source": "/projects/:id/edit", "destination": "/edit-project-:id.html" },
        { "source": "/spa/**", "destination": "/index.html" }
      ]
    }
  },
  "runner": {
    "l0": {
      "clean": ["segment_rewrite", "spa_fallback"]
    }
  },
  "requests": [
    { "name": "segment_rewrite", "method": "GET", "path": "/projects/123/edit" },
    { "name": "spa_fallback", "method": "GET", "path": "/spa/some/deep/path" }
  ]
}
