{
  "id": "notfound-shape",
  "description": "Shape of a 404 response when no 404.html exists. Tests both the default text/html error page and the application/json branch via Accept header.",
  "fixture": {
    "files": {
      "index.html": "root\n"
    }
  },
  "runner": {
    "l0": {
      "clean": [
        "missing_html",
        "missing_html_with_accept"
      ],
      "divergent": [],
      "bodyMayDiffer": [
        "missing_html"
      ],
      "contentLengthMayDiffer": [
        "missing_html_with_accept"
      ],
      "contentEncodingMayDiffer": [
        "missing_html"
      ]
    }
  },
  "requests": [
    {
      "name": "missing_html",
      "method": "GET",
      "path": "/does-not-exist"
    },
    {
      "name": "missing_html_with_accept",
      "method": "GET",
      "path": "/does-not-exist",
      "headers": {
        "accept": "application/json"
      }
    }
  ]
}
