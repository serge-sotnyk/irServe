{
  "id": "redirects-destination-forms",
  "description": "Q-007: how serve-handler renders the Location header for the destination forms — absolute URL (https://...), scheme-relative (//host/...), leading-slashless relative path (foo/bar), absolute path (/foo/bar), and a destination with `..` segments. The reference's `toTarget` at serve-handler/src/index.js:69-89 picks `slasher(destination)` when `url.parse(destination).protocol` is falsy, otherwise passes the destination through verbatim. `slasher` is `path.posix.normalize(path.posix.join('/', value))` (glob-slash.js:6), so consecutive slashes collapse AND `..` segments resolve. This probe pins each branch with a snapshot.",
  "fixture": {
    "files": {
      "_marker.txt": "marker\n"
    },
    "serveJson": {
      "redirects": [
        { "source": "/abs", "destination": "https://example.com/x" },
        { "source": "/proto", "destination": "//example.com/x" },
        { "source": "/rel", "destination": "foo/bar" },
        { "source": "/abs-path", "destination": "/foo/bar" },
        { "source": "/up", "destination": "a/../b" },
        { "source": "/up-leading", "destination": "../b" },
        { "source": "/empty", "destination": "" }
      ]
    }
  },
  "runner": {
    "l0": {
      "clean": [
        "absolute_https",
        "scheme_relative",
        "relative_no_leading_slash",
        "absolute_path_baseline",
        "dotdot_resolved",
        "dotdot_leading_resolved",
        "empty_destination_root"
      ],
      "contentLengthMayDiffer": [
        "absolute_https",
        "scheme_relative",
        "relative_no_leading_slash",
        "absolute_path_baseline",
        "dotdot_resolved",
        "dotdot_leading_resolved",
        "empty_destination_root"
      ]
    }
  },
  "requests": [
    { "name": "absolute_https", "method": "GET", "path": "/abs" },
    { "name": "scheme_relative", "method": "GET", "path": "/proto" },
    { "name": "relative_no_leading_slash", "method": "GET", "path": "/rel" },
    { "name": "absolute_path_baseline", "method": "GET", "path": "/abs-path" },
    { "name": "dotdot_resolved", "method": "GET", "path": "/up" },
    { "name": "dotdot_leading_resolved", "method": "GET", "path": "/up-leading" },
    { "name": "empty_destination_root", "method": "GET", "path": "/empty" }
