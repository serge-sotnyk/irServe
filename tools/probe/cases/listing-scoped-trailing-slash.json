    }
  },
  "runner": {
    "l0": {
      "clean": ["docs_with_trailing_slash", "blog_out_of_scope"],
      "divergent": [],
      "bodyMayDiffer": ["docs_with_trailing_slash", "blog_out_of_scope"]
    }
  },
  "requests": [
    { "name": "docs_with_trailing_slash", "method": "GET", "path": "/docs/" },
    { "name": "blog_out_of_scope", "method": "GET", "path": "/blog/" }
  ]
