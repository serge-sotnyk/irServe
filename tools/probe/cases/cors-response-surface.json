{
  "id": "cors-response-surface",
  "description": "Enumerate the CORS response-header surface under --cors across response types: 200 file, 301 cleanUrls redirect, 404 missing path. Backs SRV-CORS-001.",
  "fixture": {
    "files": {
      "index.html": "<!doctype html><title>home</title>\n",
      "asset.css": "body{}\n"
    }
  },
  "serveArgs": ["--cors"],
  "runner": {
    "l0": {
      "clean": ["file_200", "cleanurls_301", "missing_404"],
      "divergent": [],
      "bodyMayDiffer": ["missing_404"],
      "contentLengthMayDiffer": ["cleanurls_301"]
    }
  },
  "requests": [
    { "name": "file_200", "path": "/asset.css" },
    { "name": "cleanurls_301", "path": "/index.html" },
    { "name": "missing_404", "path": "/nope" }
  ]
}
