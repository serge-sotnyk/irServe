{
  "$schemaVersion": 1,
  "case": "cors-user-override",
  "description": "SRV-CLI-010 + SRV-HDR-001: a user `serve.json#headers` rule overrides the `--cors` default. Reference's CORS pre-pass at `third_party/serve/source/utilities/server.ts:65-70` is overwritten by `serve-handler`'s `Object.assign(defaultHeaders, related)` + final `response.setHeader` loop (`serve-handler/src/index.js:245-251`, `:767`). irserve mirrors via set-only-if-missing semantics in `apply_cors` (Codex review round 1 P1 fix).",
  "fixture": {
    "files": {
      "asset.css": "body{}\n"
    },
    "serveJson": {
      "headers": [
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "access-control-allow-origin",
              "value": "https://example.test"
            }
          ]
        }
      ]
    }
  },
  "serveArgs": [
    "--cors"
  ],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "css_with_user_acao",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/asset.css"
      },
      "response": {
        "body": {
          "kind": "text",
          "length": 7,
          "sha256": "2708d73bf31c36cdfa1aa466551ed101017280fa546caba4473cfef6e92a93b5",
          "preview": "body{}\n"
        },
        "headers": {
          "accept-ranges": "bytes",
          "access-control-allow-credentials": "true",
          "access-control-allow-headers": "*",
          "access-control-allow-origin": "https://example.test",
          "access-control-allow-private-network": "true",
          "content-length": "7",
          "content-type": "text/css; charset=utf-8",
          "etag": "\"3daef43df4ef7acd6f554df47081815e1e7eb8ff\"",
          "vary": "Accept-Encoding"
        },
        "status": 200,
        "statusText": "OK"
      }
    }
  ]
}
