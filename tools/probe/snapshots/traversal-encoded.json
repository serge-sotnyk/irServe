{
  "$schemaVersion": 1,
  "case": "traversal-encoded",
  "description": "Path traversal probes: percent-encoded, multi-slash, plain dot-dot. Records the actual response codes. Note: clients may normalize //... so observe carefully.",
  "fixture": {
    "files": {
      "index.html": "root\n",
      "secret.txt": "secret\n"
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "encoded_dotdot",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/%2e%2e/etc/passwd"
      },
      "response": {
        "body": {
          "kind": "text",
          "length": 1641,
          "sha256": "8c45c679f40c3f81c111fbf2398d568189c3ab34d8a9704ad225cd8efe1b819f",
          "preview": "<!DOCTYPE html><head> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\"/> <style> body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Rob"
        },
        "headers": {
          "content-encoding": "gzip",
          "content-type": "text/html; charset=utf-8",
          "vary": "Accept-Encoding"
        },
        "status": 404,
        "statusText": "Not Found"
      }
    },
    {
      "name": "double_slash_passwd",
      "request": {
