{
  "$schemaVersion": 1,
  "case": "cors-on-redirect",
  "description": "SRV-CLI-010: CORS headers ride on configured 3xx redirects too. The reference's `--cors` branch sets headers via `setHeader` BEFORE serve-handler runs (`third_party/serve/source/utilities/server.ts:65-70`), so they survive the redirect path. irserve's CORS pass runs post-dispatch and skips no status class — unlike `apply_custom_headers`, which deliberately skips 3xx (`crates/irserve-core/src/custom_headers.rs:182`).",
  "fixture": {
    "files": {
      "index.html": "redirect-target\n"
    },
    "serveJson": {
      "redirects": [
        {
          "source": "/old",
          "destination": "/new",
          "type": 302
        }
      ]
    }
  },
  "serveArgs": [
    "--cors"
  ],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "redirect_with_cors",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/old"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "access-control-allow-credentials": "true",
          "access-control-allow-headers": "*",
          "access-control-allow-origin": "*",
          "access-control-allow-private-network": "true",
          "location": "/new"
        },
        "status": 302,
        "statusText": "Found"
      }
    }
  ]
}
