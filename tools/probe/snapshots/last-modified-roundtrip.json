{
  "$schemaVersion": 1,
  "case": "last-modified-roundtrip",
  "description": "Closes Q-009. Under `--no-etag`, reference emits Last-Modified instead of ETag. Probes confirm that the reference has no `If-Modified-Since` branch (`serve-handler/src/index.js:758-765` only checks `if-none-match`): every IMS variant returns the full 200 body. First request captures `Last-Modified`; subsequent requests replay it via `$fromResponse` or use static past/future/malformed values. The 404 case pins that IMS against a missing file is inert too.",
  "fixture": {
    "files": {
      "asset.css": "body{color:red}\n"
    }
  },
  "serveArgs": [
    "--no-etag"
  ],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
