          "length": 16,
          "sha256": "74d94aede163ac74eb42fe7cac4066626820fa15001ddf02c3b2d25df8e6c771",
          "preview": "body{color:red}\n"
        },
        "headers": {
          "accept-ranges": "bytes",
          "content-length": "16",
          "content-type": "text/css; charset=utf-8",
          "last-modified": "Mon, 11 May 2026 11:08:15 GMT",
          "vary": "Accept-Encoding"
        },
        "status": 200,
        "statusText": "OK"
      }
    },
    {
      "name": "ims_exact",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/asset.css",
        "headers": {
          "if-modified-since": {
            "$fromResponse": {
              "request": "first_get",
              "header": "last-modified"
            }
