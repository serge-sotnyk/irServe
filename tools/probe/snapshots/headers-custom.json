{
  "$schemaVersion": 1,
  "case": "headers-custom",
  "description": "Custom headers via serve.json applied to a specific path; null value removes a default header.",
  "fixture": {
    "files": {
      "page.html": "<p>hi</p>\n"
    },
    "serveJson": {
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=600"
            },
            {
              "key": "X-Custom",
              "value": "yes"
            }
          ]
        }
      ]
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "html_get",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/page.html"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "location": "/page"
        },
        "status": 301,
        "statusText": "Moved Permanently"
      }
    }
  ]
}
