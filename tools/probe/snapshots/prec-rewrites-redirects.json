{
  "$schemaVersion": 1,
  "case": "prec-rewrites-redirects",
  "description": "When both rewrites and redirects match the same path, which one fires? Fixture: redirect /go -> /target, rewrite /go -> /alt.html. Both /target.html and /alt.html exist. Also tests precedence with cleanUrls redirect on /page.html.",
  "fixture": {
    "files": {
      "target.html": "<p>target</p>\n",
      "alt.html": "<p>alt</p>\n",
      "page.html": "<p>page</p>\n"
    },
    "serveJson": {
      "redirects": [
        {
          "source": "/go",
          "destination": "/target"
        }
      ],
      "rewrites": [
        {
          "source": "/go",
          "destination": "/alt.html"
        }
      ]
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "go_root",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/go"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "location": "/target"
        },
        "status": 301,
        "statusText": "Moved Permanently"
      }
    },
    {
      "name": "page_html_cleanurl_default",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/page.html"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "location": "/page"
        },
        "status": 301,
        "statusText": "Moved Permanently"
      }
    }
  ]
}
