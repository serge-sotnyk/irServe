    "files": {
      "about.html": "<p>about</p>\n",
      "index.html": "<p>home</p>\n"
    },
    "serveJson": {
      "trailingSlash": false,
      "cleanUrls": false
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
