          "length": 7,
          "sha256": "2708d73bf31c36cdfa1aa466551ed101017280fa546caba4473cfef6e92a93b5",
          "preview": "body{}\n"
        },
        "headers": {
          "accept-ranges": "bytes",
          "cache-control": "public, max-age=600",
          "content-length": "7",
          "content-type": "text/css; charset=utf-8",
          "etag": "\"3daef43df4ef7acd6f554df47081815e1e7eb8ff\"",
