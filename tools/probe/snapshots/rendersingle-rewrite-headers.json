{
  "$schemaVersion": 1,
  "case": "rendersingle-rewrite-headers",
  "description": "renderSingle fires for the rewritten directory; custom headers match against the served file's path (under the REWRITTEN target), not the original request URL. Reference overrides `absolutePath` at `serve-handler/src/index.js:649-665` and runs `getHeaders` on the resolved file path at `index.js:746`. Codex review round 2 P2 regression guard.",
  "fixture": {
    "files": {
      "docs/photo.png": {
        "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR4nGNgAAIAAAUAAeImBZsAAAAASUVORK5CYII="
      }
    },
    "serveJson": {
      "renderSingle": true,
      "rewrites": [
        {
          "source": "/old",
          "destination": "/docs"
        }
      ],
      "headers": [
        {
          "source": "/docs/photo.png",
          "headers": [
            {
              "key": "X-Tag",
              "value": "docs"
            }
          ]
        },
        {
          "source": "/old/photo.png",
          "headers": [
            {
              "key": "X-Tag",
              "value": "old"
            }
          ]
        }
      ]
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "rewrite_to_single_with_headers",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/old"
      },
      "response": {
        "body": {
          "kind": "binary",
          "length": 68,
          "sha256": "1c8170ab1ab003e5a7d3f03e0b34c9cb71a6fd02bd33b3298fb40dd67fcea7b9"
        },
        "headers": {
          "accept-ranges": "bytes",
          "content-length": "68",
          "content-type": "image/png",
          "etag": "\"3a5cbe8616cac2f71749dfc65491529dec6f1414\"",
          "x-tag": "docs"
        },
        "status": 200,
        "statusText": "OK"
      }
    }
  ]
}
