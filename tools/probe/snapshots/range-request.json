          "content-type": "text/plain; charset=utf-8",
          "etag": "\"df13ea7b971f3dad54f0deb102c5bc9fa0d052ae\"",
          "vary": "Accept-Encoding"
        },
        "status": 206,
        "statusText": "Partial Content"
