    "files": {
      "blob.txt": "abcdefghij\n",
      "empty.txt": "",
      "tagged.txt": "abcdefghij\n"
    },
    "serveJson": {
      "headers": [
        {
          "source": "tagged.txt",
          "headers": [
            {
              "key": "Content-Range",
              "value": "custom-value"
            }
          ]
        }
      ]
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
