{
  "$schemaVersion": 1,
  "case": "etag-roundtrip",
  "description": "ETag round-trip: request a non-html file (no cleanUrls redirect), capture its ETag, then re-request with matching If-None-Match. Expect 304 and an empty body.",
  "fixture": {
    "files": {
      "asset.css": "body{color:red}\n"
    }
  },
  "serveArgs": [],
