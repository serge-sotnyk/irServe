{
  "$schemaVersion": 1,
  "case": "cors-flag",
  "description": "CLI --cors flag adds Access-Control-Allow-* headers. Confirms presence/absence relative to default.",
  "fixture": {
    "files": {
      "page.html": "<p>x</p>\n"
    }
  },
  "serveArgs": [
    "--cors"
  ],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "html_with_cors",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/page.html"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "access-control-allow-credentials": "true",
          "access-control-allow-headers": "*",
          "access-control-allow-origin": "*",
          "access-control-allow-private-network": "true",
          "location": "/page"
        },
        "status": 301,
        "statusText": "Moved Permanently"
      }
    }
  ]
}
