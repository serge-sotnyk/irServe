{
  "$schemaVersion": 1,
  "case": "prec-trailing-redirects",
  "description": "Precedence test: when both `trailingSlash` and `redirects` could fire on the same source path, which wins? Reference's `shouldRedirect` orders trailingSlash (lines 145-168) BEFORE the redirects loop (lines 172-182), so the trailingSlash 301 fires first and the configured redirect is never reached. Closes one corner of SRV-ROUT-006 left open at the end of Stage 6c.",
  "fixture": {
    "files": {
      "_marker.txt": "marker\n"
    },
    "serveJson": {
      "trailingSlash": true,
      "cleanUrls": false,
      "redirects": [
        {
          "source": "/face/mask",
          "destination": "/elsewhere"
        }
      ]
    }
  },
  "serveArgs": [],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "trailing_add_wins_over_redirect",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/face/mask"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "location": "/face/mask/"
        },
        "status": 301,
        "statusText": "Moved Permanently"
      }
    }
  ]
}
