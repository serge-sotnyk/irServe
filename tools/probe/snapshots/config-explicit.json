{
  "$schemaVersion": 1,
  "case": "config-explicit",
  "description": "`--config <path>` loads a non-default JSON file as the routing/headers configuration. Backs SRV-CLI-009 and SRV-CFG-001. The fixture has both a default-named `serve.json` (NOT used because --config takes precedence) and an alternate `routes.json`; the request hits a redirect that only exists in the alternate file.",
  "fixture": {
    "files": {
      "page.html": "<p>page</p>\n",
      "routes.json": "{\n  \"redirects\": [\n    { \"source\": \"/old\", \"destination\": \"/page.html\" }\n  ]\n}\n"
    },
    "serveJson": {
      "redirects": [
        {
          "source": "/old",
          "destination": "/should-not-be-used"
        }
      ]
    }
  },
  "serveArgs": [
    "--config",
    "routes.json"
  ],
  "volatileHeaders": [
    "last-modified"
  ],
  "volatileBodies": [],
  "requests": [
    {
      "name": "redirect_from_alternate_config",
      "request": {
        "method": "GET",
        "mode": "fetch",
        "path": "/old"
      },
      "response": {
        "body": {
          "kind": "empty",
          "length": 0,
          "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "headers": {
          "location": "/page.html"
        },
        "status": 301,
        "statusText": "Moved Permanently"
      }
    }
  ]
}
